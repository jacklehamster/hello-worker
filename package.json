{
  "name": "@dobuki/hello-worker",
  "version": "1.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser/webrtc-room": {
      "types": "./dist/webrtc-room.d.ts",
      "default": "./dist/webrtc-room.js"
    },
    "./browser/signal-room": {
      "types": "./dist/signal-room.d.ts",
      "default": "./dist/signal-room.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "wrangler dev src/index.ts --config wrangler.dev.toml",
    "deploy": "wrangler deploy",
    "build": "bun i && bun build src/browser/*.ts --target browser --outdir public --minify --sourcemap && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {}
}
